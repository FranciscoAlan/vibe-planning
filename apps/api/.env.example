# Runtime & Server
NODE_ENV=development
PORT=3000

# Databases & Caching
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvp_db?schema=public
REDIS_URL=redis://localhost:6379

# Search Engine
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# Business Logic
BOOKING_DEFAULT_HOLD_HOURS=24

# Security & Tokens (Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=super_secret_local_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=15m
IDENTITY_REFRESH_TTL_DAYS=30

# Base64-encoded 32-byte key for AES-256-GCM TOTP secret encryption (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
IDENTITY_2FA_ENCRYPTION_KEY=dGhpc2lzYTMyYnl0ZXNlY3JldGtleWZvcmFlczI1NmdjbSE=

# Verification / OTP Constraints
IDENTITY_PHONE_TTL_MINUTES=5
IDENTITY_PHONE_MAX_ATTEMPTS=3
IDENTITY_PHONE_RESEND_SECONDS=60

IDENTITY_EMAIL_TTL_MINUTES=15
IDENTITY_EMAIL_MAX_ATTEMPTS=5
IDENTITY_EMAIL_RESEND_SECONDS=60

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OAuth - Facebook / Meta
FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# Payments - Stripe (Test Mode)
STRIPE_SECRET_KEY=your_stripe_secret_key

# SMS - Twilio (Test Credentials)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CLIENT_SECRET=OUp9KXr1EvDZmh931RN5VPg3gb65wL3l
TWILIO_FROM_NUMBER=+15005550006

# Transactional Email - Resend
RESEND_API_KEY=re_12345678_exampleApiKeyForLocalDev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Firebase Admin SDK (Auth / Push Notifications)
# Nota: La private key debe manejar saltos de línea con \n
FIREBASE_PROJECT_ID=mvp-personal-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@mvp-personal-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Media Storage - Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
