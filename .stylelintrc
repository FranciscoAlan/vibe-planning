{
  "ignoreFiles": ["node_modules/**/*", "dist/**/*", "www/**/*"],
  "plugins": ["stylelint-order"],
  "indentation": 2,
  "rules": {
    "at-rule-empty-line-before": [
      "always",
      {
        "except": ["blockless-after-same-name-blockless", "first-nested"],
        "ignore": ["after-comment"]
      }
    ],
    "at-rule-name-format": "lower",
    "block-no-empty": true,
    "block-opening-brace-space": "always",
    "block-opening-brace-newline": "always-multi-line",
    "color-hex-case-format": "lower",
    "color-hex-length": "short",
    "custom-property-empty-line-before": [
      "always",
      {
        "except": ["after-comment", "after-custom-property", "first-nested"],
        "ignore": ["inside-single-line-block"]
      }
    ],
    "declaration-block-no-duplicate-properties": true,
    "order/order": ["custom-properties", "dollar-variables", "at-rules", "declarations", "rules"],
    "order/properties-alphabetical-order": true,
    "property-no-unknown": true,
    "property-disallowed-list": []
  },
  "string-quotes": "double",
  "validate": {
    "scss": true,
    "css": true
  }
}
