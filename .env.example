# Copy this file to the environment-specific configuration used by your deployment.
# Never commit real credentials.

# Application
NODE_ENV=development
PORT=3000

# Core infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vibe_planners?schema=public"
REDIS_URL="redis://localhost:6379"
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Identity
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/identity/google/callback"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL="http://localhost:3000/identity/facebook/callback"

# External providers
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
IDENTITY_PHONE_TTL_MINUTES=10
IDENTITY_PHONE_MAX_ATTEMPTS=5
IDENTITY_PHONE_RESEND_SECONDS=60
IDENTITY_EMAIL_TTL_MINUTES=15
IDENTITY_EMAIL_MAX_ATTEMPTS=5
IDENTITY_EMAIL_RESEND_SECONDS=60
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
